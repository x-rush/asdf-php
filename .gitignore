# L2 build outputs live in GitHub Releases, not in git.
out/
l2-*.log

# generated build inputs (scripts/gen-build-inputs.py) and local build trees
# (build/macos.sh stages prefixes and toolchains here)
build/.gen/
build/prefix/
build/toolchain/

# local smoke / regression scratch dirs
.asdf-php-smoke.*/
.smoke-reg/
.runcheck/
.smoketest/

# locally built tarballs that bin/install picks up before any release download.
# The real location is $HOME/.asdf-php-dist; the repo-relative form is listed
# because it is easy to create by accident and 150 MB of tarballs must never be
# committed. .dist-staging is the same thing under another name.
.asdf-php-dist/
.dist-staging/

# Pinned build inputs are NOT in this branch. `asdf plugin add` clones this
# branch, so anything here is downloaded by every user at install time — and
# they never need the sources, only the prebuilt tarball. The archived copies
# live on the build-inputs branch; scripts/vendor.sh re-fetches and verifies
# them against vendor/SOURCES.json whenever a local build actually needs them.
/vendor/*
!/vendor/SOURCES.json
/keys/

# partial vendor downloads (scripts/vendor.sh)
*.part

.DS_Store
Thumbs.db

# python bytecode from the build helpers
__pycache__/
*.pyc
