#!/usr/bin/env bash
# asdf-php v2 / 瘦插件
# 契约不变：asdf 传入 ASDF_INSTALL_VERSION / ASDF_INSTALL_PATH，插件把 bin/php 放进该目录。
# 变化：插件不再编译、不再探测系统库、不再拼 configure。
set -euo pipefail

: "${ASDF_INSTALL_VERSION:?asdf did not set ASDF_INSTALL_VERSION}"
: "${ASDF_INSTALL_PATH:?asdf did not set ASDF_INSTALL_PATH}"

v="$ASDF_INSTALL_VERSION"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$(uname -m)" in
  x86_64|amd64)  arch="x86_64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "asdf-php: unsupported CPU $(uname -m)" >&2; exit 1 ;;
esac
plat="${os}-${arch}"

# Platforms that actually have published artifacts. Keep in sync with
# manifest.json -> platforms and README -> Platform support; scripts/test.sh
# asserts all three agree. Checking here turns a bare HTTP 404 into a
# message that says what is available instead of what failed.
SUPPORTED="linux-x86_64"
# Platforms that are designed and being built but have no artifact yet. Saying
# "planned" instead of "unsupported" matters: a user who came for 7.4 on ARM
# should not conclude the project is dead.
PLANNED="linux-arm64 darwin-x86_64 darwin-arm64"
# Versions that will never have a given platform, as opposed to not having one
# yet. Conflating the two is the difference between "wait a month" and "this
# combination does not exist": 5.4/5.6 build on debian:jessie, whose official
# multi-arch index is 386/amd64/armv5/armv7 only, and moving to a base with
# arm64 would raise glibc past 2.19, which is the whole point of those versions.
# Must stay disjoint from each version's [artifact].targets; T3p asserts it.
UNAVAILABLE="5.4.45:linux-arm64 5.6.40:linux-arm64"
# Test seam only: scripts/test.sh overrides these to exercise the Rosetta
# fallback before darwin artifacts exist. Production never sets them.
[ -n "${ASDF_PHP_SUPPORTED:-}" ] && SUPPORTED="$ASDF_PHP_SUPPORTED"
[ -n "${ASDF_PHP_PLANNED:-}" ] && PLANNED="$ASDF_PHP_PLANNED"
[ -n "${ASDF_PHP_UNAVAILABLE:-}" ] && UNAVAILABLE="$ASDF_PHP_UNAVAILABLE"

is_supported() { case " $SUPPORTED " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

if ! is_supported "$plat"; then
  # Apple Silicon can run the Intel build through Rosetta 2. That is why the
  # macOS matrix is half as big as it looks: one darwin-x86_64 artifact serves
  # Intel Macs natively and Apple Silicon via translation. Prefer a native
  # darwin-arm64 artifact when one exists; only fall back when it does not.
  if [ "$plat" = "darwin-arm64" ] && is_supported "darwin-x86_64"; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      echo "asdf-php: no arm64 build published; using darwin-x86_64 under Rosetta 2" >&2
      plat="darwin-x86_64"
    else
      cat >&2 <<'ROSETTA'
asdf-php: this release ships only a darwin-x86_64 build. That runs on Apple
          Silicon through Rosetta 2, but Rosetta is not installed.
          Install it once, then re-run:
              softwareupdate --install-rosetta --agree-to-license
ROSETTA
      exit 1
    fi
  else
    case " $UNAVAILABLE " in
      *" ${v}:${plat} "*)
        cat >&2 <<EOF
asdf-php: PHP ${v} will not be built for ${plat}.
          The base image for this version (debian:jessie) publishes no arm64
          build, and the reason ${v} exists is that it runs against glibc 2.19 —
          which a newer base would take away. This is a deliberate limit, not a
          missing milestone, so there is nothing to wait for.
          For arm64 use 7.2 and newer: asdf install php 7.4.33
EOF
        exit 1 ;;
    esac
    echo "asdf-php: no prebuilt artifact for ${plat}" >&2
    echo "asdf-php: currently published: ${SUPPORTED}" >&2
    case " $PLANNED " in
      *" $plat "*) echo "asdf-php: ${plat} is planned but not published yet (see the README roadmap)" >&2 ;;
    esac
    echo "asdf-php: see the Platform support table in README.md" >&2
    echo "asdf-php: nothing was downloaded; your existing installs are untouched" >&2
    exit 1
  fi
fi

base="${ASDF_PHP_RELEASE_BASE:-https://github.com/x-rush/asdf-php/releases/download}"
name="php-${v}-${plat}.tar.gz"
url="${base}/php-${v}/${name}"

# macOS has no sha256sum; Git Bash on Windows ships shasum. Resolve once.
if command -v sha256sum >/dev/null 2>&1; then
  hash_cmd() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
  hash_cmd() { shasum -a 256 "$1" | awk '{print $1}'; }
else
  echo "asdf-php: no sha256 tool found (need sha256sum or shasum)" >&2
  exit 1
fi

work="$(mktemp -d)"
# Cleanup must never change the install result (some hosts restrict temp
# deletion). Everything is verified before this trap runs.
trap 'rm -rf -- "$work" 2>/dev/null || true' EXIT

curl -fL --retry 3 -o "$work/$name" "$url"
curl -fL --retry 3 -o "$work/$name.sha256" "$url.sha256"

expected="$(awk 'NR==1 {print $1}' "$work/$name.sha256")"
actual="$(hash_cmd "$work/$name")"
if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
  echo "asdf-php: sha256 mismatch for $name" >&2
  exit 1
fi

mkdir -p "$ASDF_INSTALL_PATH"
tar -xzf "$work/$name" -C "$ASDF_INSTALL_PATH"
if [ ! -x "$ASDF_INSTALL_PATH/bin/php" ]; then
  echo "asdf-php: artifact has no bin/php" >&2
  exit 1
fi

"$ASDF_INSTALL_PATH/bin/php" -v | head -1
echo "asdf-php: $v installed from frozen artifact; see manifest.json for EOL/security status" >&2
